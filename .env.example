# Template for local environment variables. Copy to .env.local and fill in.
#   cp .env.example .env.local
#
# Browser-safe values only (Vite exposes every VITE_* variable to the client):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Secrets that must stay on the server (e.g. a service_role key) must NOT start with VITE_.
# For the Cloudflare/Nitro server build, put them in .dev.vars (git-ignored) locally
# and in your host's secret settings in production.
